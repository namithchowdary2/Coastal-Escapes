{
  "redirects": [
    {
      "source": "/old-home",
      "destination": "/",
      "permanent": true
    }
  ],
  {
  "routes": [
    { "src": "^/sitemap\\.xml$", "dest": "/sitemap.xml" },
    { "src": "^/robots\\.txt$", "dest": "/robots.txt" },
    { "src": "^(?!/sitemap\\.xml$|/robots\\.txt$).*", "dest": "/index.html" }
  ]
}
